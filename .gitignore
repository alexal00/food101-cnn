# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS metadata
.DS_Store
._*

# Local editor/project notes
.obsidian/
.vscode/
ObsidianNotes/

# Virtual environments
.venv/
venv/
env/

# Local raw data stays ignored; the processed cache is versioned so Colab can
# train without downloading, indexing, or regenerating resized images.
data/raw/**
data/reports/**
outputs/**

# Model/checkpoint/archive artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.keras
*.tar.gz
*.pdf

# Keep directory placeholders.
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/reports/
!data/reports/.gitkeep
!data/reports/corrupted_images.txt
!data/reports/dataset_index.csv
!data/reports/image_validation_report.csv
!outputs/
!outputs/**/
!outputs/**/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Final deliverable artifacts are versioned intentionally. Large binary files
# matched below are stored through Git LFS by .gitattributes.
!outputs/final_selected/
!outputs/final_selected/**
!outputs/figures/**/*.csv
!outputs/figures/**/*.png
!outputs/reports/**/*.csv
!outputs/reports/**/*.json
!outputs/reports/**/*.md
